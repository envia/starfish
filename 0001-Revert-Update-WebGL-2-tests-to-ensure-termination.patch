-class PrngXorwow {
-  /** @type {U32[]} */
-  actual_seed;
-
-  /** @type {U32[]} */
-  state = new Uint32Array(6); // 5 u32 shuffler + 1 u32 counter.
-
-  /**
-   * @param {U32[] | U32 | undefined} seed
