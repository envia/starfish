-  if (n > 0) {
-      const result_mask = (1 << (32-n)) - 1;
-      val &= result_mask;
-  }
-
-  return val;
-}
-console.assert((0xffff_ffff | 0) == -1);
-console.assert(0xffff_ff00 >> 4 == (0xffff_fff0 | 0));
-console.assert(shr_u32(0xffff_ff00, 4) != (0xffff_fff0 | 0));
-console.assert(shr_u32(0xffff_ff00, 4) == (0x0fff_fff0 | 0));
