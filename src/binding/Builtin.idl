// https://heycam.github.io/webidl/#common

/*
typedef (Int8Array or Int16Array or Int32Array or
         Uint8Array or Uint16Array or Uint32Array or Uint8ClampedArray or
         Float32Array or Float64Array or DataView) ArrayBufferView;
*/
typedef (ArrayBufferView or ArrayBuffer) BufferSource;
typedef unsigned long long DOMTimeStamp;

// callback Function = any (any... arguments);
callback VoidFunction = void ();

// https://drafts.csswg.org/cssom/#typedefdef-cssomstring
typedef USVString CSSOMString;

// https://webidl.spec.whatwg.org/#ref-for-AllowSharedBufferSource
// FIXME: Support [AllowShared] by binding_generator
// typedef (ArrayBuffer or SharedArrayBuffer or [AllowShared] ArrayBufferView) AllowSharedBufferSource;
typedef (ArrayBuffer or SharedArrayBuffer or ArrayBufferView) AllowSharedBufferSource;
