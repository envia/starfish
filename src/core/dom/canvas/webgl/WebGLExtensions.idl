// Support LegacyNoInterfaceObject renamed from NoInterfaceObject
// Refs: https://github.com/whatwg/webidl/commit/62963e8f09522e05a281940a083ed21ab4a934fa

// https://registry.khronos.org/webgl/extensions/

// 1. OES_texture_float
[STARFISH_ENABLE_WEBGL, Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface OES_texture_float { };

// 2. OES_texture_half_float
[STARFISH_ENABLE_WEBGL, Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface OES_texture_half_float {
  const GLenum HALF_FLOAT_OES = 0x8D61;
};

// 4. OES_standard_derivatives
[STARFISH_ENABLE_WEBGL, Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface OES_standard_derivatives {
    const GLenum FRAGMENT_SHADER_DERIVATIVE_HINT_OES = 0x8B8B;
};

// 9. WEBGL_depth_texture
[STARFISH_ENABLE_WEBGL, Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface WEBGL_depth_texture {
  const GLenum UNSIGNED_INT_24_8_WEBGL = 0x84FA;
};

// 11. EXT_texture_filter_anisotropic
[STARFISH_ENABLE_WEBGL, Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface EXT_texture_filter_anisotropic {
  const GLenum TEXTURE_MAX_ANISOTROPY_EXT = 0x84FE;
  const GLenum MAX_TEXTURE_MAX_ANISOTROPY_EXT = 0x84FF;
};

// 20. OES_texture_float_linear
[STARFISH_ENABLE_WEBGL, Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface OES_texture_float_linear { };

// 25. EXT_blend_minmax
[STARFISH_ENABLE_WEBGL, Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface EXT_blend_minmax {
  const GLenum MIN_EXT = 0x8007;
  const GLenum MAX_EXT = 0x8008;
};

// 14. EXT_color_buffer_half_float (WebGL 1 and 2)
[STARFISH_ENABLE_WEBGL, Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface EXT_color_buffer_half_float {
  const GLenum RGBA16F_EXT = 0x881A;
  const GLenum RGB16F_EXT = 0x881B;
  const GLenum FRAMEBUFFER_ATTACHMENT_COMPONENT_TYPE_EXT = 0x8211;
  const GLenum UNSIGNED_NORMALIZED_EXT = 0x8C17;
};

// 31. EXT_color_buffer_float (WebGL 2 only)
[STARFISH_ENABLE_WEBGL, Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface EXT_color_buffer_float { };

// 32. WEBGL_color_buffer_float (WebGL 1 only)
[STARFISH_ENABLE_WEBGL, Exposed=(Window,Worker), LegacyNoInterfaceObject]
interface WEBGL_color_buffer_float {
  const GLenum RGBA32F_EXT = 0x8814;
  const GLenum FRAMEBUFFER_ATTACHMENT_COMPONENT_TYPE_EXT = 0x8211;
  const GLenum UNSIGNED_NORMALIZED_EXT = 0x8C17;
};
